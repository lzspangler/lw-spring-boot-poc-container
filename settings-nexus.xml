<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0
                              https://maven.apache.org/xsd/settings-1.2.0.xsd">

    <!--
      Nexus Maven configuration.
      Use: mvn -s settings-nexus.xml <goal>

      Mirror: all remote repositories and plugins resolve through maven-public.
    -->

    <localRepository>${user.home}/.m2/repository-nexus</localRepository>

    <mirrors>
        <mirror>
            <id>nexus-maven-public</id>
            <name>Nexus Maven Public</name>
            <url>https://nexus-nexus.apps-crc.testing/repository/maven-public/</url>
            <mirrorOf>*</mirrorOf>
        </mirror>
    </mirrors>

    <profiles>
        <profile>
            <id>nexus</id>
            <repositories>
                <repository>
                    <id>nexus-maven-public</id>
                    <name>Nexus Maven Public</name>
                    <url>https://nexus-nexus.apps-crc.testing/repository/maven-public/</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository>
                    <id>nexus-maven-public</id>
                    <name>Nexus Maven Public</name>
                    <url>https://nexus-nexus.apps-crc.testing/repository/maven-public/</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>
    </profiles>

    <activeProfiles>
        <activeProfile>nexus</activeProfile>
    </activeProfiles>

</settings>
